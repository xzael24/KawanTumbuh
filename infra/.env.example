# ===========================================================================
# KAWANTUMBUH - contoh konfigurasi environment
#
# Cara pakai:
#   cp .env.example .env
#   # ubah semua nilai password/secret sebelum deploy ke VPS
#
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# ===========================================================================

# ---------------------------------------------------------------------------
# Umum
# ---------------------------------------------------------------------------
TZ=Asia/Jakarta

# development -> TypeORM synchronize aktif (tabel dibuat otomatis).
# Ganti ke production SETELAH migrasi TypeORM tersedia.
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=kawantumbuh
POSTGRES_USER=kawantumbuh
POSTGRES_PASSWORD=ganti-password-ini

# DATABASE_URL otomatis dibentuk dari POSTGRES_* di atas, jadi tidak perlu diisi.
# Isi hanya jika memakai database eksternal (di luar compose), contoh:
# DATABASE_URL=postgres://user:pass@host-luar:5432/kawantumbuh
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Minimal 32 karakter acak. Contoh membuat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Daftar origin yang boleh mengakses API, pisahkan dengan koma.
# Gunakan * hanya untuk development.
# Contoh produksi: https://app.kawantumbuh.id,https://admin.kawantumbuh.id
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# AI services (alamat internal Docker, jangan diubah kecuali nama service)
# ---------------------------------------------------------------------------
AI_TIMEOUT_MS=60000
AI_SENTIMENT_URL=

# ---------------------------------------------------------------------------
# Penyimpanan media
# ---------------------------------------------------------------------------
# local  -> volume Docker media_data (default, cukup untuk MVP)
# minio  -> butuh profile "storage"
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_MB=12

# ---------------------------------------------------------------------------
# OPSIONAL - MinIO (docker compose --profile storage up -d)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ganti-minio-password
MINIO_ENDPOINT=
MINIO_BUCKET=kawantumbuh

# ---------------------------------------------------------------------------
# OPSIONAL - Redis / BullMQ (docker compose --profile queue up -d)
# ---------------------------------------------------------------------------
REDIS_URL=
