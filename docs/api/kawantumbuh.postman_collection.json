      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bunda_sarah\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"rahasia123\",\n  \"termsAccepted\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.user && res.user.id) pm.environment.set('userId', res.user.id);",
                  "if (res.accessToken) pm.environment.set('accessToken', res.accessToken);",
                  "if (res.refreshToken) pm.environment.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
